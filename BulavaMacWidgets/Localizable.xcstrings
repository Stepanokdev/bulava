        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чек тижня"
          }
        }
      }
    },
    "What the week's work would have cost at API prices. An estimate, not what you pay." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько стоила бы работа недели по ценам API. Это оценка, а не то, что ты платишь."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скільки коштувала б робота тижня за цінами API. Це оцінка, а не те, що ти платиш."
