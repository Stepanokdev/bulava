        }
      }
    },
    "Hours without you, accepted runs, the receipt and the week's rhythm on one face." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часы без тебя, принятые прогоны, чек и ритм недели на одном виджете."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Години без тебе, прийняті прогони, чек і ритм тижня на одному віджеті."
          }
        }
      }
    },
    "Open Bulava and this fills in within minutes." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открой Булаву, и через несколько минут здесь появятся цифры."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відкрий Булаву, і за кілька хвилин тут з'являться цифри."
          }
        }
      }
    },
    "Connect to Bulava on your Mac and this fills in." : {
      "extractionState" : "manual",
      "localizations" : {
