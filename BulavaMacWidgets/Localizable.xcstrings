{
  "sourceLanguage" : "en",
  "strings" : {
    "Without you" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без тебя"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без тебе"
          }
        }
      }
    },
    "How long the agents worked this week, and how much work each of your messages started." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сколько агенты работали на этой неделе и сколько работы запускало каждое твоё сообщение."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скільки агенти працювали цього тижня і скільки роботи запускало кожне твоє повідомлення."
          }
        }
      }
    },
    "How runs ended" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогоны"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прогони"
          }
        }
      }
    },
    "What review accepted this week, what it accepted with remarks, and what waited for you." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что ревью приняло на этой неделе, что приняло с замечаниями и что ждало тебя."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Що рев'ю прийняло цього тижня, що прийняло із зауваженнями і що чекало на тебе."
          }
        }
      }
    },
    "Receipt of the week" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чек недели"
