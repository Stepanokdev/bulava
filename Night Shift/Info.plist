<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BulavaChannel</key>
	<string>$(BULAVA_CHANNEL)</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_bulava-link._tcp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Bulava talks to the Bulava app on your phone over this Wi-Fi, directly — nothing goes through the internet.</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUFeedURL</key>
	<string>https://bulava.app/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>ujpj9MQY9z1yX5BFRIm/jNUB2Jfqhn181PMkJUR3slI=</string>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
</dict>
</plist>
