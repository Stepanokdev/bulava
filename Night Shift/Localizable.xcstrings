        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Куди рушій пише ліміти, сесії та чергу."
          }
        }
      }
    },
    "Which of this product's resources should this be done in?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В каком ресурсе этого продукта это делать?"
