    "Bulava calls it by name and reads its answers, so a mismatched copy misreports work. Install the one this version shipped with." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulava вызывает его по имени и читает ответы, поэтому несовпадающая копия искажает результат. Установи тот, что пришёл с этой версией."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bulava викликає його за іменем і читає відповіді, тож копія іншої версії перекручує результат. Встанови той, що прийшов із цією версією."
          }
        }
      }
    },
    "Bulava can change it" : {
      "extractionState" : "stale",
