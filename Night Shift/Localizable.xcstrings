    },
    "A pinned version. It stays on this model when a newer one ships." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зафиксированная версия. Останется на этой модели, когда выйдет новее."
