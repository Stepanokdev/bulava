    },
    "It had already been read. Your next message will say it replaces this one." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его уже прочитали. Следующее сообщение скажет, что оно заменяет это."
