      }
    },
    "Weekly: committed secrets and vulnerable dependencies, reported without the secret values." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждую неделю: закоммиченные секреты и уязвимые зависимости, в отчёте без самих секретов."
          }
        },
        "uk" : {
