    "Weekly: adds focused tests to important code that has none, without touching that code." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждую неделю: добавляет прицельные тесты к важному коду без тестов, не трогая сам код."
          }
        },
        "uk" : {
          "stringUnit" : {
