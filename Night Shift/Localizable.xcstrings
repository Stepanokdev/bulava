          }
        }
      }
    },
    "Weekly: applies patch and minor updates, runs the tests, and lists the major ones." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждую неделю: применяет patch- и minor-обновления, запускает тесты и перечисляет major."
