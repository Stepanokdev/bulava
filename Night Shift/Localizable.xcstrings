        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "у tmux досі відкрита сесія воркера"
          }
        }
      }
    },
    "Accept" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
