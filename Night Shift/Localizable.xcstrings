        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex шукає причину в «%@». Щойно виправить, повідомлення піде знову."
          }
        }
      }
    },
    "Codex is looking for the cause in “%@”. The message may already have arrived, so it will not be sent again by itself." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex ищет причину в «%@». Сообщение могло уже дойти, поэтому само повторно оно не уйдёт."
          }
        },
        "uk" : {
