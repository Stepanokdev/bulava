    "%1$@ is a folder holding %2$@. A run cannot start in it — Bulava does not lay a repository over other people's repositories." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» — это папка, внутри которой %2$@. Запустить работу в ней не получится: Bulava не делает git поверх чужих репозиториев."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» — це тека, в якій лежить %2$@. Запустити роботу в ній не вийде: Bulava не робить git поверх чужих репозиторіїв."
          }
        }
      }
    },
