    "It stopped without asking anything — open the trail to see where" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оно остановилось, ничего не спросив — открой ход работы, чтобы увидеть где"
          }
        },
        "uk" : {
          "stringUnit" : {
