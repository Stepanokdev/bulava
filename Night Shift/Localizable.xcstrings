      }
    },
    "Weekly: corrects what the README and docs say that is no longer true." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждую неделю: исправляет в README и документации то, что уже неправда."
