    },
    "It is deleted from disk. Installing it again goes through the audit like any new skill." : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он удаляется с диска. Чтобы вернуть — установка снова пройдёт аудит, как любой новый скил."
