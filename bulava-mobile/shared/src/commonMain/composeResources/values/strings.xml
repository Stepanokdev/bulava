    <string name="app_name">Bulava</string>

    <!-- Onboarding -->
    <string name="onboarding_title">Bulava, on your phone</string>
    <string name="onboarding_lede">Your Mac keeps doing the work. From here you can start a chat, answer a question or stop a run, and pick up at the desk where you left off.</string>
    <string name="step_install_title">Install Bulava on your Mac</string>
    <string name="step_install_body">It is a free download from bulava.app. The phone does nothing by itself: every task runs on the Mac.</string>
    <string name="step_wifi_title">Use the same Wi‑Fi</string>
    <string name="step_wifi_body">The phone talks to the Mac directly over your local network. It cannot connect from another network, and that is deliberate: your work never goes through the internet.</string>
    <string name="step_scan_title">Scan the code on the Mac</string>
    <string name="step_scan_body">Click the phone icon in the toolbar on the Mac. It shows a code. Scan it from here.</string>
    <string name="action_scan">Scan the code</string>
    <string name="action_paste_link">Paste a pairing link instead</string>
    <string name="action_get_mac_app">Get Bulava for Mac</string>
    <string name="paste_title">Pairing link</string>
    <string name="paste_hint">A link starting with bulava.app/pair</string>
    <string name="paste_body">If the camera cannot be used, scan the code with any QR reader or the phone’s own camera. It opens a page with a button that brings the code here. You can also paste the link yourself.</string>
    <string name="paste_invalid">That is not a Bulava pairing link.</string>
