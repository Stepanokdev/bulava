<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BulavaLiveKeychainGroup</key>
	<string>$(AppIdentifierPrefix)com.stepanok.bulava.live</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.stepanok.bulava.refresh</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>uk</string>
		<string>ru</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.stepanok.bulava.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>bulava</string>
			</array>
		</dict>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSBonjourServices</key>
	<array>
		<string>_bulava-link._tcp</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
</dict>
</plist>
