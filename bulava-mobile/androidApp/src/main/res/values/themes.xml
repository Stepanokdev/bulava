<resources>
    <style name="Theme.Bulava" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- The notification-button screen: nothing drawn, only the system's unlock prompt. -->
